    {
      "parameters": {
        "jsCode": "// Arma el texto del aviso semanal con lo que devolvió el portal.\nconst r = $input.first().json;\nconst lista = (r.moved || []).slice(0, 15).map(m => `• ${m.file}  (se queda ${m.keep})`).join('\\n');\nconst mas = r.count > 15 ? `\\n… y ${r.count - 15} más.` : '';\nconst texto = `Limpieza semanal: hay ${r.count} archivo(s) de revisiones viejas para mandar a OBSOLETO.\\n\\n${lista}${mas}\\n\\n` +\n              `Para ejecutarla: portal → Limpieza → Ejecutar. ${r.portal_url || ''}`;\nreturn [{ json: { count: r.count, texto } }];"
      },
